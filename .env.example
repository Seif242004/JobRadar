# Copy to .env (git-ignored). Never commit real values.

# Database (defaults match docker-compose.yml)
JOBRADAR_DB_URL=jdbc:postgresql://localhost:5432/jobradar
JOBRADAR_DB_USER=jobradar
JOBRADAR_DB_PASSWORD=jobradar

# LLM and embeddings: OpenAI-compatible endpoint (SPEC.md D1, D3). Used from M2.
JOBRADAR_AI_BASE_URL=https://integrate.api.nvidia.com/v1
JOBRADAR_AI_MODEL=openai/gpt-oss-20b
JOBRADAR_AI_KEY=

# Optional: master profile to import on api startup (git-ignored, see seed/profile.example.json)
JOBRADAR_PROFILE_SEED_FILE=

# AWS (LocalStack locally). Leave JOBRADAR_AWS_ENDPOINT empty on real AWS.
AWS_REGION=eu-central-1
JOBRADAR_AWS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
JOBRADAR_SQS_HOT_URL=http://sqs.eu-central-1.localhost.localstack.cloud:4566/000000000000/jobradar-hot
JOBRADAR_SQS_BACKLOG_URL=http://sqs.eu-central-1.localhost.localstack.cloud:4566/000000000000/jobradar-backlog

# Ingestion worker: in-process schedule for the source connectors and the careers resolver.
JOBRADAR_SCHEDULING_ENABLED=true
JOBRADAR_WORKABLE_LOCATIONS=Egypt

# Gmail alert reader (ingestion-worker): the one label to read, and the OAuth client shared with the apply flow.
JOBRADAR_GMAIL_ALERT_LABEL=JobRadar
JOBRADAR_GOOGLE_CLIENT_ID=
JOBRADAR_GOOGLE_CLIENT_SECRET=

# Embeddings: nvidia/llama-3.2-nv-embedqa-1b-v1 answers 404 now; nemotron-3-embed-1b works, returns 2048 values,
# and is cut to the first 1024 (ranking checked on 2026-11-11). Set JOBRADAR_AI_EMBEDDING_TRUNCATE=false and
# JOBRADAR_AI_EMBEDDING_DIMENSIONS=1024 for a model that supports the dimensions parameter.
